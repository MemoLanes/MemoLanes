  <trk>
    <extensions><ml:journey date="2026-09-11"/></extensions>
    <trkseg>
      <trkpt lat="1" lon="2"><extensions>
        <custom:trkpt lat="9" lon="8"/>
        <custom:trkpt lat="9" lon="8"></custom:trkpt>
        <custom:trkseg/>
        <custom:trkseg></custom:trkseg>
        <custom:trk/>
