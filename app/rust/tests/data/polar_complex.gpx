<?xml version='1.0' encoding='utf-8'?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="MemoLanes synthetic polar test generator">
  <metadata>
    <name>MemoLanes Journey - Compact complex polar tests</name>
    <desc>Synthetic coordinates only; no timestamps. Four independent tracks: a seam weave and a five-petal polar rose in each hemisphere. Keep them separate to avoid long connecting arcs. Default import: no preprocessing.</desc>
  </metadata>
  <trk>
    <name>North - Seam weave</name>
    <desc>Three oscillations across the Mercator/LAEA seam, crossing the antimeridian. Latitude = seam + 0.002*sin(6*pi*t + pi/6), longitude = 179.99 + 0.02*t, t = i/24.</desc>
