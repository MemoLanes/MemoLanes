/target
tests/fixtures/*.bin.tmp

# stray default-output tmp from running geo_rasterizer in this dir
*.bin.tmp

# Natural Earth source GeoJSON downloaded on demand by `just rasterize-geo`,
# reproducible from the pins in geo_data_format::worldview. README.md is kept.
# `*.tmp` covers the in-flight download before it's renamed into place.
natural_earth/*.geojson
natural_earth/*.tmp

# CLDR name sources downloaded on demand by `just rasterize-geo`,
# reproducible from the pins in geo_data_format::cldr.
cldr/*.json
cldr/*.tmp
